    "schema_version": "1.0",
    "estado": "I4d_factores_electricos_nacionales_aplicados_vivienda_y_coche_electrico",
    "descripcion": "Factores nacionales medios anuales de intensidad de emisiones de la electricidad de red. Desde I4c se aplican a la electricidad de Vivienda y a los excedentes fotovoltaicos; desde I4d se aplican también al coche eléctrico cuando la carga no está marcada como ya incluida en Vivienda.",
    "fuente_principal": "Ember Yearly Electricity Data / Ember Data API",
    "fuente_url": "https://github.com/ember-energy/ember-data-api/blob/main/data/api_country_overview_yearly.csv",
