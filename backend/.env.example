NODE_ENV=development
PORT=3000
# Origen del frontend (en producción, la URL de Vercel)
CORS_ORIGIN=http://localhost:5173
# Secreto para firmar los JWT (reemplazar antes de desplegar)
JWT_SECRET=replace-this-example-with-a-random-secret-before-deploy
JWT_EXPIRES_IN=1h
FRONTEND_URL=http://localhost:5173
# Identificador de la versión publicada de términos y privacidad
CONSENT_POLICY_VERSION=v1
# SMTP. Si SMTP_HOST está vacío, en desarrollo el correo se imprime en el log
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Plataforma <no-reply@example.com>"
# Número de proxies de confianza delante de la API (p. ej. 1 en Render/Railway/Heroku).
# Obligatorio fuera de development/test; en local déjalo vacío.
TRUST_PROXY=
# Clave para cifrar el secreto TOTP en la BD: 32 bytes en hexadecimal (64 caracteres).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si la pierdes, los usuarios con 2FA no podrán validar códigos. Guárdala igual que JWT_SECRET.
TOTP_ENCRYPTION_KEY=
# MariaDB. El usuario necesita permiso para crear BDs si usas `npm run db:migrate` (crea una "shadow database").
DATABASE_URL="mysql://user:password@host:3306/web_platform"
